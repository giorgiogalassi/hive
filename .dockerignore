# Never bake secrets into the image; supply them at runtime via docker-compose env_file.
.env

# Dependencies and build output are produced inside the image.
node_modules/
dist/
build/

# Legacy Python tree is not part of the image.
hive/
hive_cli.py
pyproject.toml
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# Repo metadata and editor noise.
.git/
.claude/
.DS_Store
