{
  "name": "hive",
  "version": "0.1.0",
  "description": "Hive: run AI coding agents against labelled GitHub issues.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24"
  },
  "bin": {
