# Copy this file to .env and fill in the values before starting the app.
# The .env file is never committed to git and is never baked into the Docker image.
#
# ── Layered env resolution (CLI only) ─────────────────────────────────────────
#
# The `hive` CLI loads variables from two optional .env files.
# Priority order (highest -> lowest):
#
#   1. process environment / shell exports  - always win; never overridden.
#   2. .env in the current working dir      - per-project config.
#   3. ~/.hive/.env                         - machine-level secret fallback.
#
# Recommended split:
#   ~/.hive/.env        ->  GITHUB_TOKEN, ANTHROPIC_API_KEY
#   <project>/.env      ->  GITHUB_OWNER, GITHUB_REPO (and project-specific keys)
#
# The webhook receiver (Docker / `pnpm start`) does not layer: Compose passes this
# repo-root .env via `env_file` in docker-compose.yml.
# ──────────────────────────────────────────────────────────────────────────────

# Secret used to verify HMAC-SHA256 signatures on incoming GitHub webhook payloads.
# Set this to the same value you configure in GitHub -> Settings -> Webhooks -> Secret.
# The receiver refuses to start without it.
GITHUB_WEBHOOK_SECRET=

# Personal Access Token with read AND write permissions.
# Classic PAT: repo scope. Fine-grained PAT: contents:read/write + issues:write
# + pull requests:write.
# Write permission is required to post comments; read-only tokens fail silently.
#
# Machine-level secret -> recommended location: ~/.hive/.env
GITHUB_TOKEN=

# Anthropic API key. Default credential for both runners (claude-code and
# claude-agent-sdk). If set, it wins over CLAUDE_CODE_OAUTH_TOKEN.
#
# Machine-level secret -> recommended location: ~/.hive/.env
ANTHROPIC_API_KEY=

# Personal-use option only: OAuth token from `claude setup-token`.
# Used only when ANTHROPIC_API_KEY is unset. Do not use for shared/unattended deployments.
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional: path to a Claude Code executable for the claude-agent-sdk runner,
# overriding the binary bundled with the SDK.
# HIVE_CLAUDE_CODE_PATH=

# GitHub username of the repo owner; used to identify owner PR comments that re-queue Cody.
#
# Per-project value -> recommended location: <project>/.env
GITHUB_OWNER=your-github-username

# Target repository for hive run, in owner/repo format.
# Optional: if unset, hive run auto-detects from the git remote origin URL.
# Set this explicitly when running inside Docker or CI where there is no git remote.
#
# Per-project value -> recommended location: <project>/.env
# GITHUB_REPO=your-username/your-repo

# Optional: port the webhook receiver listens on (default 8000).
# docker-compose.yml maps host 8000 to container 8000, so leave unset under Compose.
# PORT=8000
